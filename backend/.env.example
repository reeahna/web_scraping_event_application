APP_NAME="Bulletin"
APP_ENV=development
APP_PORT=8100
DATABASE_URL=sqlite:///./app.db
LOG_LEVEL=INFO
# Sign-in is only through Google / Microsoft / Facebook / X / Yahoo (no passwords).
# REGISTRATION_ENABLED=false stops first sign-ins from creating new accounts.
REGISTRATION_ENABLED=true
# This address becomes a Super Administrator when it signs in with a provider
# that has verified it (use a Google account).
SUPERADMIN_EMAIL=
# Adds "Sign in as the test user" to the sign-in page, for development and
# staging only (refused with APP_ENV=production). The account is created on
# first use as a Registered User.
TEST_LOGIN_ENABLED=false
TEST_USER_EMAIL=test-user@bulletin.invalid

# --- production hardening (Phase 18): set all of these in production ---
COOKIE_SECURE=false                 # true behind HTTPS
BEHIND_HTTPS=false                  # true when TLS-terminated upstream
TRUSTED_HOSTS=[]                    # e.g. ["events.example.com"]
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_BACKEND=memory           # prod: redis (or database)
REDIS_URL=                          # e.g. redis://redis:6379/0
# prod DATABASE_URL example: postgresql://user:pw@host:5432/db

# --- sign-in providers (blank = that button is hidden; set at least one) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Defaults to the site's own address; set only if providers must return elsewhere.
OAUTH_REDIRECT_BASE_URL=

# --- geocoding (disabled by default; Nominatim needs a descriptive UA) ---
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=disabled         # nominatim
GEOCODING_USER_AGENT=city-events-app/1.0 (contact: admin@example.com)

# --- restricted-browser recovery (disabled by default) ---
# Enables the "Retry with restricted browser detection" action for unsupported
# sources (app.services.browser_recovery). Requires Playwright chromium.
BROWSER_EXTRACTION_ENABLED=false
# Headless Chromium instances one process may run at once (each takes a few
# hundred MB). Keep at 1 on a 512MB instance.
BROWSER_MAX_CONCURRENT=1

# --- email (disabled by default; no email sent unless configured) ---
EMAIL_ENABLED=false                 # alert emails
EMAIL_SIGN_IN_ENABLED=false         # sign in with a code sent by email
# Key the sign-in codes are hashed with (32+ chars). Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_CODE_SECRET=
EMAIL_BACKEND=noop                  # console (logs, dev only) | smtp
EMAIL_FROM=alerts@example.com
# For EMAIL_BACKEND=smtp, e.g. Gmail with an app password:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- error monitoring (off unless a DSN is set; see docs/deploy-render.md) ---
SENTRY_DSN=

# Visitor log at /admin/visitors: no cookies, no stored IPs (docs/operations.md).
VISIT_TRACKING_ENABLED=true
VISIT_FLUSH_SECONDS=60
VISIT_RETENTION_DAYS=180
# Share of web requests traced for performance (0 = off).
SENTRY_TRACES_SAMPLE_RATE=0.02

# --- admin access key for automated jobs (off unless both are set; see docs/security.md) ---
# At least 32 random characters. Requests send "Authorization: Bearer <key>".
ADMIN_API_KEY=
# The existing admin account the key acts as.
ADMIN_API_KEY_USER_EMAIL=

# --- AI (disabled by default; never required) ---
AI_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=

# Search engine ownership checks: paste only the content="..." value of the
# meta tag that Google Search Console ("HTML tag") or Bing Webmaster Tools
# gives. Public tokens, not secrets. Leave unset to add no tag.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
