APP_NAME="Bulletin"
APP_ENV=development
APP_PORT=8100
DATABASE_URL=sqlite:///./app.db
LOG_LEVEL=INFO
# Sign-in is only through Google / Microsoft / Facebook (no passwords).
# REGISTRATION_ENABLED=false stops first sign-ins from creating new accounts.
REGISTRATION_ENABLED=true
# This address becomes a Super Administrator when it signs in with a provider
# that has verified it (use a Google account).
SUPERADMIN_EMAIL=

# --- production hardening (Phase 18): set all of these in production ---
COOKIE_SECURE=false                 # true behind HTTPS
BEHIND_HTTPS=false                  # true when TLS-terminated upstream
TRUSTED_HOSTS=[]                    # e.g. ["events.example.com"]
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_BACKEND=memory           # prod: redis (or database)
REDIS_URL=                          # e.g. redis://redis:6379/0
# prod DATABASE_URL example: postgresql://user:pw@host:5432/db

# --- sign-in providers (blank = that button is hidden; set at least one) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Defaults to the site's own address; set only if providers must return elsewhere.
OAUTH_REDIRECT_BASE_URL=

# --- geocoding (disabled by default; Nominatim needs a descriptive UA) ---
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=disabled         # nominatim
GEOCODING_USER_AGENT=city-events-app/1.0 (contact: admin@example.com)

# --- restricted-browser recovery (disabled by default) ---
# Enables the "Retry with restricted browser detection" action for unsupported
# sources (app.services.browser_recovery). Requires Playwright chromium.
BROWSER_EXTRACTION_ENABLED=false

# --- email alerts (disabled by default; no email sent unless configured) ---
EMAIL_ENABLED=false
EMAIL_BACKEND=noop                  # console
EMAIL_FROM=alerts@example.com

# --- AI (disabled by default; never required) ---
AI_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=
