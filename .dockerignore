# The build context is the repository root (render.yaml), but the image only
# needs backend/ and frontend/. Keep it small and never bake local state into it.
.git/
.github/
docs/
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
backend/tests/

# Local database + backups live on the persistent disk in production, never in
# the image (DATABASE_URL points at /data/app.db).
**/app.db
**/app.db-*
**/app.db.backup-*
**/*.db
**/*.sqlite3

# Local secrets / env — production config comes from Render env vars.
**/.env
